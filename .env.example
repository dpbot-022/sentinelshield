# SentinelShield Configuration Template
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Security & JWT (Generate a strong 256-bit secret in production)
JWT_SECRET_KEY=sentinel-shield-ultra-secure-zero-trust-secret-key-2026-prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Inference (Get your free key from https://console.groq.com/keys)
DEFAULT_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Local Ollama Fallback (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
